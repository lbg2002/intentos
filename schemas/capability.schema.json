{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intentos.org/schemas/v1/capability.schema.json",
  "title": "IntentOS Capability Descriptor v1",
  "type": "object",
  "required": ["id", "summary", "effects", "execution"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
    "version": { "type": "integer", "minimum": 1, "default": 1 },
    "summary": { "type": "string", "minLength": 2 },
    "category": { "type": "string" },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "l0_patterns": { "type": "array", "items": { "type": "string" } },
    "input_schema": { "type": "object" },
    "effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "observe",
          "ui",
          "setting",
          "exec.sandboxed",
          "write.reversible",
          "egress",
          "process.control",
          "write.destructive",
          "external.commit",
          "system.admin"
        ]
      }
    },
    "idempotent": { "type": "boolean" },
    "execution": { "type": "object", "required": ["type"] },
    "setting": { "type": "object" },
    "undo": { "type": "string", "enum": ["none", "changeset", "restore_previous_value"] },
    "verification": { "type": "object" },
    "feedback": { "type": "string" },
    "dependencies": { "type": "array", "items": { "type": "string" } }
  }
}
